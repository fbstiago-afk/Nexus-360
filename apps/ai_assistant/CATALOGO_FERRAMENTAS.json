    {
      "name": "simular_cenario",
      "description": "Resultado operacional sob premissas (preco, desconto, volume, custo, frete, despesas). Nao e previsao.",
      "input_schema": {
        "type": "object",
        "properties": {
          "periodo": {
            "type": "object",
            "description": "Intervalo de datas (inclusive), limitado a 01/01/2024..31/10/2026 (corte).",
            "properties": {
              "inicio": {
                "type": "string",
                "format": "date"
              },
              "fim": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "inicio",
              "fim"
            ],
            "additionalProperties": false
          },
          "filiais": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Belo Horizonte",
                "Brasília",
                "Campinas",
                "Curitiba",
                "Goiânia",
                "Joinville",
                "Maringá",
                "Porto Alegre",
                "Ribeirão Preto",
                "Rio de Janeiro",
                "Sorocaba",
                "São Paulo"
              ]
            },
            "description": "Filiais (dFilial[Cidade]). Vazio = todas."
          },
          "preco": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 0.2,
            "multipleOf": 0.01,
            "default": 0
          },
          "desconto_pp": {
            "type": "integer",
            "minimum": -5,
            "maximum": 5,
            "default": 0
          },
          "volume": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 0.2,
            "multipleOf": 0.01,
            "default": 0
          },
          "custo": {
            "type": "number",
            "minimum": -0.1,
            "maximum": 0.1,
            "multipleOf": 0.01,
            "default": 0
          },
          "frete": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 0.2,
            "multipleOf": 0.01,
            "default": 0
          },
          "despesas": {
            "type": "number",
            "minimum": -0.2,
            "maximum": 0.2,
            "multipleOf": 0.01,
            "default": 0
          }
        },
        "required": [
          "periodo"
        ],
        "additionalProperties": false
