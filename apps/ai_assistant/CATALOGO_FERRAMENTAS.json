    {
      "name": "projecao_receita",
      "description": "Projecao sazonal mensal apos o corte, com faixa de 90% (metodo documentado na pagina Predictive).",
      "input_schema": {
        "type": "object",
        "properties": {
          "filiais": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Belo Horizonte",
                "Brasília",
                "Campinas",
                "Curitiba",
