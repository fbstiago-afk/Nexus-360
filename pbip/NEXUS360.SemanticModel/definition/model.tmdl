model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parametros

	annotation PBI_QueryGroupOrder = 0

queryGroup Funcoes

	annotation PBI_QueryGroupOrder = 1

queryGroup Staging

	annotation PBI_QueryGroupOrder = 2

queryGroup Dimensoes

	annotation PBI_QueryGroupOrder = 3

queryGroup Fatos

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["pPastaDados","pDataCorte","fxLerCsv","stgPedido","stgFaturaData","stgCompra","stgPosicao","stgClienteFilial","stgPrevisaoDatas","_Medidas","_Parametros","dCalendario","dCampanha","dCliente","dFilial","dFornecedor","dPosicaoArmazem","dProduto","dTransportadora","dVendedor","fCompra","fContasPagar","fContasReceber","fDespesa","fDevolucao","fEntrega","fEstoqueMensal","fFaturamento","fInteracaoCampanha","fItemPedido","fMeta","fMovimentoEstoque","fOcupacaoArmazem","fOrcamento","fPedido","fPrevisao","fVisitaComercial"]

ref table _Medidas
ref table _Parametros
ref table dCalendario
ref table dCampanha
ref table dCliente
ref table dFilial
ref table dFornecedor
ref table dPosicaoArmazem
ref table dProduto
