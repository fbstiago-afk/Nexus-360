ref table fMeta
ref table fMovimentoEstoque
ref table fOcupacaoArmazem
ref table fOrcamento
ref table fPedido
ref table fPrevisao
ref table fVisitaComercial
ref table 'Param Limite Ativo'
ref table 'Param Limite Churn'
ref table 'Param Janela Comparativa'
ref table dStatusCliente
ref table dCohortOffset
ref table dKPI
