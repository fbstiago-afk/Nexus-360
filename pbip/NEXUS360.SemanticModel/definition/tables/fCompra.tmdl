	/// 1 quando DataCompra <= pDataCorte
	column ElegivelHistorico
		dataType: int64
		formatString: 0
		lineageTag: 35ae59d1-c11f-4785-93ee-30eddb02e6d9
		summarizeBy: none
		sourceColumn: ElegivelHistorico

	partition fCompra = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fCompra"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"CompraID", Int64.Type}, {"FornecedorID", Int64.Type}, {"FilialID", Int64.Type}, {"ProdutoID", Int64.Type}, {"DataCompra", type date}, {"Quantidade", Int64.Type}, {"ValorCompra", Currency.Type}, {"StatusCompra", type text}}, "en-US"),
				    Elegivel = Table.AddColumn(Tipado, "ElegivelHistorico", each if [DataCompra] <= pDataCorte then 1 else 0, Int64.Type)
				in
				    Elegivel

	annotation PBI_ResultType = Table

