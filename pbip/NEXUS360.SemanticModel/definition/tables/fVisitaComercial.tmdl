	partition fVisitaComercial = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fVisitaComercial"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"VisitaID", Int64.Type}, {"VendedorID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataVisita", type date}, {"TipoContato", type text}, {"Resultado", type text}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"ClienteID"}, stgClienteFilial, {"ClienteID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"FilialID"}, {"FilialID"}),
				    Retipado = Table.TransformColumnTypes(Expandido, {{"FilialID", Int64.Type}}, "en-US")
				in
				    Retipado

	annotation PBI_ResultType = Table

