				    Fonte = fxLerCsv("fOrcamento"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"OrcamentoID", Int64.Type}, {"DataReferencia", type date}, {"FilialID", Int64.Type}, {"Conta", type text}, {"ValorOrcado", Currency.Type}}, "en-US")
				in
