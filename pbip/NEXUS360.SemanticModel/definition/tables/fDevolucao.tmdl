	partition fDevolucao = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fDevolucao"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"DevolucaoID", Int64.Type}, {"PedidoID", Int64.Type}, {"DataDevolucao", type date}, {"ValorDevolvido", Currency.Type}, {"Motivo", type text}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"PedidoID"}, stgPedido, {"PedidoID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"ClienteID", "FilialID", "VendedorID"}, {"ClienteID", "FilialID", "VendedorID"}),
				    Retipado = Table.TransformColumnTypes(Expandido, {{"ClienteID", Int64.Type}, {"FilialID", Int64.Type}, {"VendedorID", Int64.Type}}, "en-US")
				in
				    Retipado

	annotation PBI_ResultType = Table

