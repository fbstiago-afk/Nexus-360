	/// Data da compra de origem
	column DataCompra
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 8e18774b-acd8-40e1-aea5-1d76f04c6bfd
		summarizeBy: none
		sourceColumn: DataCompra

		annotation UnderlyingDateTimeDataType = Date

	/// 1 quando DataCompra <= pDataCorte
	column ElegivelHistorico
		dataType: int64
		formatString: 0
		lineageTag: 736bab1e-c56a-49c2-a641-36abb2942a3b
		summarizeBy: none
		sourceColumn: ElegivelHistorico

	partition fContasPagar = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fContasPagar"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"PagamentoID", Int64.Type}, {"CompraID", Int64.Type}, {"ValorTitulo", Currency.Type}, {"Vencimento", type date}, {"DataPagamento", type date}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"CompraID"}, stgCompra, {"CompraID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"FilialID", "FornecedorID", "ProdutoID", "DataCompra"}, {"FilialID", "FornecedorID", "ProdutoID", "DataCompra"}),
				    Retipado = Table.TransformColumnTypes(Expandido, {{"FilialID", Int64.Type}, {"FornecedorID", Int64.Type}, {"ProdutoID", Int64.Type}, {"DataCompra", type date}}, "en-US"),
				    Elegivel = Table.AddColumn(Retipado, "ElegivelHistorico", each if [DataCompra] <= pDataCorte then 1 else 0, Int64.Type)
				in
				    Elegivel

	annotation PBI_ResultType = Table

