		lineageTag: 70848d85-5ca8-4e45-8a8a-1e9ff282ab9d
		summarizeBy: none
		sourceColumn: EntregaOTIF

	partition fEntrega = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fEntrega"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"EntregaID", Int64.Type}, {"PedidoID", Int64.Type}, {"TransportadoraID", Int64.Type}, {"DataPrometida", type date}, {"DataEntrega", type date}, {"PesoKg", type number}, {"CustoFrete", Currency.Type}, {"NoPrazo", Int64.Type}, {"InFull", Int64.Type}, {"StatusEntrega", type text}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"PedidoID"}, stgPedido, {"PedidoID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"ClienteID", "FilialID", "VendedorID", "DataPedido"}, {"ClienteID", "FilialID", "VendedorID", "DataPedido"}),
				    Retipado = Table.TransformColumnTypes(Expandido, {{"ClienteID", Int64.Type}, {"FilialID", Int64.Type}, {"VendedorID", Int64.Type}, {"DataPedido", type date}}, "en-US"),
				    Atraso = Table.AddColumn(Retipado, "DiasAtraso", each Duration.Days([DataEntrega] - [DataPrometida]), Int64.Type),
				    LeadTime = Table.AddColumn(Atraso, "LeadTimePedidoDias", each Duration.Days([DataEntrega] - [DataPedido]), Int64.Type),
				    OTIF = Table.AddColumn(LeadTime, "EntregaOTIF", each if [NoPrazo] = 1 and [InFull] = 1 then 1 else 0, Int64.Type)
				in
				    OTIF

	annotation PBI_ResultType = Table

