	partition fItemPedido = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fItemPedido"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"ItemPedidoID", Int64.Type}, {"PedidoID", Int64.Type}, {"ProdutoID", Int64.Type}, {"Quantidade", Int64.Type}, {"PrecoUnitario", Currency.Type}, {"ValorLiquido", Currency.Type}, {"CustoMercadoria", Currency.Type}, {"Tributacao", type text}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"PedidoID"}, stgPedido, {"PedidoID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"ClienteID", "FilialID", "VendedorID", "CampanhaID", "DataPedido", "StatusPedido", "Canal", "DescontoPercentual"}, {"ClienteID", "FilialID", "VendedorID", "CampanhaID", "DataPedido", "StatusPedido", "Canal", "DescontoPercentual"}),
				    MescladoF = Table.NestedJoin(Expandido, {"PedidoID"}, stgFaturaData, {"PedidoID"}, "F", JoinKind.LeftOuter),
				    ExpandidoF = Table.ExpandTableColumn(MescladoF, "F", {"FaturaID", "DataFaturamento"}, {"FaturaID", "DataFaturamento"}),
				    Retipado = Table.TransformColumnTypes(ExpandidoF, {{"ClienteID", Int64.Type}, {"FilialID", Int64.Type}, {"VendedorID", Int64.Type}, {"CampanhaID", Int64.Type}, {"DataPedido", type date}, {"StatusPedido", type text}, {"Canal", type text}, {"DescontoPercentual", type number}, {"FaturaID", Int64.Type}, {"DataFaturamento", type date}}, "en-US")
				in
				    Retipado

	annotation PBI_ResultType = Table

