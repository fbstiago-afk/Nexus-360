/// Vendedores. FilialID = filial de lotacao, sem relacao (M2).
table dVendedor
	lineageTag: c9ad1538-db38-4b4d-aa63-2bf9e89f4867

	column VendedorID
		dataType: int64
		formatString: 0
		lineageTag: b48506c2-74e7-472c-90b8-2f9f6d308a21
		summarizeBy: none
		sourceColumn: VendedorID

	column Vendedor
		dataType: string
		lineageTag: 3f4f5208-93dc-42eb-baba-f9a88b8547ff
		summarizeBy: none
		sourceColumn: Vendedor

	column FilialID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 80e6ba63-eca9-43d4-b5c1-4406068b8030
		summarizeBy: none
		sourceColumn: FilialID

	column Equipe
		dataType: string
		lineageTag: 5d3e7bcb-c7ad-448e-beca-a643bf4bf66a
		summarizeBy: none
