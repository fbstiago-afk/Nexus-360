	partition dVendedor = m
		mode: import
		queryGroup: Dimensoes
		source =
				let
				    Fonte = fxLerCsv("dVendedor"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"VendedorID", Int64.Type}, {"Vendedor", type text}, {"FilialID", Int64.Type}, {"Equipe", type text}, {"DataAdmissao", type date}, {"Ativo", Int64.Type}}, "en-US")
				in
