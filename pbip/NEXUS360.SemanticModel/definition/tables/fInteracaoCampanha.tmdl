	partition fInteracaoCampanha = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fInteracaoCampanha"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"InteracaoID", Int64.Type}, {"CampanhaID", Int64.Type}, {"ClienteID", Int64.Type}, {"DataInteracao", type date}, {"TipoInteracao", type text}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"ClienteID"}, stgClienteFilial, {"ClienteID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"FilialID"}, {"FilialID"}),
				    Retipado = Table.TransformColumnTypes(Expandido, {{"FilialID", Int64.Type}}, "en-US")
				in
				    Retipado

	annotation PBI_ResultType = Table

