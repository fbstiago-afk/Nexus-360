		sourceColumn: Canal

	/// Fatura anterior do mesmo cliente (ordem DataFaturamento, FaturaID). Vazio na primeira compra.
	column DataCompraAnterior
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 27b4439a-8db1-4944-b288-2faa22a23e22
		summarizeBy: none
		sourceColumn: DataCompraAnterior

		annotation UnderlyingDateTimeDataType = Date

	/// Dias desde a fatura anterior do mesmo cliente (0 = mesma data). Base de recompra e reativacao.
	column DiasDesdeCompraAnterior
		dataType: int64
		formatString: #,0
		lineageTag: f9048c6f-0e77-4618-973f-4cde2cbc7168
		summarizeBy: none
		sourceColumn: DiasDesdeCompraAnterior

	partition fFaturamento = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("fFaturamento"),
				    Tipado = Table.TransformColumnTypes(Fonte, {{"FaturaID", Int64.Type}, {"PedidoID", Int64.Type}, {"DataFaturamento", type date}, {"ReceitaLiquida", Currency.Type}, {"Impostos", Currency.Type}, {"CMV", Currency.Type}}, "en-US"),
				    Mesclado = Table.NestedJoin(Tipado, {"PedidoID"}, stgPedido, {"PedidoID"}, "Ref", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(Mesclado, "Ref", {"ClienteID", "FilialID", "VendedorID", "CampanhaID", "DataPedido", "DescontoPercentual", "Canal"}, {"ClienteID", "FilialID", "VendedorID", "CampanhaID", "DataPedido", "DescontoPercentual", "Canal"}),
				    Retipado = Table.TransformColumnTypes(Expandido, {{"ClienteID", Int64.Type}, {"FilialID", Int64.Type}, {"VendedorID", Int64.Type}, {"CampanhaID", Int64.Type}, {"DataPedido", type date}, {"DescontoPercentual", type number}, {"Canal", type text}}, "en-US"),
				    Ordenado = Table.Buffer(Table.Sort(Retipado, {{"ClienteID", Order.Ascending}, {"DataFaturamento", Order.Ascending}, {"FaturaID", Order.Ascending}})),
				    Indexado = Table.AddIndexColumn(Ordenado, "Idx", 0, 1, Int64.Type),
				    ListaClientes = List.Buffer(Ordenado[ClienteID]),
				    ListaDatas = List.Buffer(Ordenado[DataFaturamento]),
				    ComAnterior = Table.AddColumn(Indexado, "DataCompraAnterior", each if [Idx] > 0 and ListaClientes{[Idx] - 1} = [ClienteID] then ListaDatas{[Idx] - 1} else null, type date),
				    ComIntervalo = Table.AddColumn(ComAnterior, "DiasDesdeCompraAnterior", each if [DataCompraAnterior] = null then null else Duration.Days([DataFaturamento] - [DataCompraAnterior]), Int64.Type),
				    SemIndice = Table.RemoveColumns(ComIntervalo, {"Idx"})
				in
				    SemIndice

	annotation PBI_ResultType = Table

