expression stgPrevisaoDatas =
		let
		    Fonte = fxLerCsv("fPrevisao"),
		    Tipado = Table.TransformColumnTypes(Fonte, {{"DataReferencia", type date}}, "en-US"),
		    Datas = List.Distinct(Tipado[DataReferencia])
		in
		    Datas
	lineageTag: 9fb9053e-e36b-460c-8948-9f6314e89313
