expression pDataCorte = #date(2026, 10, 31) meta [IsParameterQuery=true, Type="Date", IsParameterQueryRequired=true]
	lineageTag: a675997d-7cc4-4a33-a1cb-617896d5bfbc
	queryGroup: Parametros

	annotation PBI_ResultType = Date

expression fxLerCsv =
		(nome as text) as table =>
		let
		    Arquivo = File.Contents(pPastaDados & nome & ".csv"),
		    Csv = Csv.Document(Arquivo, [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		    Cabecalho = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
		    SemBOM = Table.TransformColumnNames(Cabecalho, each Text.Replace(_, Character.FromNumber(65279), "")),
		    VaziosNulos = Table.ReplaceValue(SemBOM, "", null, Replacer.ReplaceValue, Table.ColumnNames(SemBOM))
		in
		    VaziosNulos
	lineageTag: 3e7053b5-afd9-4ea9-be0a-eea7f8fee430
	queryGroup: Funcoes

	annotation PBI_ResultType = Function

expression stgPedido =
		let
		    Fonte = fxLerCsv("fPedido"),
		    Selecionado = Table.SelectColumns(Fonte, {"PedidoID", "ClienteID", "FilialID", "VendedorID", "DataPedido", "StatusPedido", "DescontoPercentual", "CampanhaID", "Canal"}),
		    Tipado = Table.TransformColumnTypes(Selecionado, {{"PedidoID", Int64.Type}, {"ClienteID", Int64.Type}, {"FilialID", Int64.Type}, {"VendedorID", Int64.Type}, {"DataPedido", type date}, {"StatusPedido", type text}, {"DescontoPercentual", type number}, {"CampanhaID", Int64.Type}, {"Canal", type text}}, "en-US"),
		    Buffer = Table.Buffer(Tipado)
		in
		    Buffer
	lineageTag: dcdb8fa2-88d8-41da-a5db-dfe0716ff377
	queryGroup: Staging

	annotation PBI_ResultType = Table

